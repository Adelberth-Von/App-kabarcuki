<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kabar" android:textSize="18sp" android:textStyle="bold" android:textColor="#24352E" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_location" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Belum ada kabar" android:textSize="16sp" android:textStyle="bold" android:textColor="#24352E" />
        <ImageView android:id="@+id/widget_art" android:layout_width="48dp" android:layout_height="48dp" android:importantForAccessibility="no" android:scaleType="fitCenter" />
    </LinearLayout>
    <TextView android:id="@+id/widget_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#56665B" />
    <TextView android:id="@+id/widget_meal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Makan belum tercatat" android:textSize="14sp" android:textColor="#24352E" />
    <TextView android:id="@+id/widget_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Buka aplikasi untuk menghubungkan" android:textSize="11sp" android:textColor="#56665B" />
    <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_outside" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/widget_button" android:text="Keluar" android:textColor="#24352E" />
        <TextView android:id="@+id/widget_home_action" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/widget_button" android:text="Kost" android:textColor="#24352E" />
        <TextView android:id="@+id/widget_meal_action" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/widget_button" android:text="Makan" android:textColor="#24352E" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
