<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_default_light">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="abc" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_phase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:textSize="10sp" android:background="@drawable/widget_button"/>
</LinearLayout>
<ViewFlipper android:id="@+id/widget_frames" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="8dp" android:autoStart="false" android:flipInterval="1500">
<ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY"/>
<ImageView android:id="@+id/widget_art_next" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY"/>
</ViewFlipper>
<TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_meal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:importantForAccessibility="no" android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
<LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<TextView android:id="@+id/widget_outside" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:textSize="12sp" android:padding="4dp" android:drawablePadding="3dp" android:maxLines="1" android:ellipsize="end" android:background="@drawable/widget_button"/>
<TextView android:id="@+id/widget_home_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:textSize="12sp" android:padding="4dp" android:drawablePadding="3dp" android:maxLines="1" android:ellipsize="end" android:background="@drawable/widget_button"/>
<TextView android:id="@+id/widget_meal_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="0dp" android:gravity="center" android:textSize="12sp" android:padding="4dp" android:drawablePadding="3dp" android:maxLines="1" android:ellipsize="end" android:background="@drawable/widget_button"/>
</LinearLayout>
<TextView android:id="@+id/widget_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
