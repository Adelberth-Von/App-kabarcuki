<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_default_light">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_title" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:text="abc" android:textStyle="bold" />
    <TextView android:id="@+id/widget_phase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="9sp" android:maxLines="1" android:includeFontPadding="false" android:background="@drawable/widget_button" />
  </LinearLayout>
  <ViewFlipper android:id="@+id/widget_frames" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="96dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:background="@drawable/widget_scene_background" android:clipToOutline="true" android:autoStart="false" android:flipInterval="240" android:inAnimation="@anim/widget_scene_in" android:outAnimation="@anim/widget_scene_out">
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/widget_art_next" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/widget_art_2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/widget_art_3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/widget_art_4" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/widget_art_5" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/widget_art_6" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/widget_art_7" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" />
  </ViewFlipper>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/widget_own_card" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="10dp" android:background="@drawable/widget_card_default_light">
      <TextView android:id="@+id/widget_own_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginBottom="3dp" />
      <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold" />
      <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_peer_card" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="10dp" android:layout_marginStart="6dp" android:background="@drawable/widget_card_default_light">
      <TextView android:id="@+id/widget_peer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginBottom="3dp" />
      <TextView android:id="@+id/widget_peer_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold" />
      <TextView android:id="@+id/widget_peer_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="4dp" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/widget_meal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="8dp" />
  <TextView android:id="@+id/widget_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="5dp" />
  <TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="5dp" />
  <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp">
    <TextView android:id="@+id/widget_outside" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="5dp" android:gravity="center" android:textSize="11sp" android:padding="5dp" android:drawablePadding="4dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:background="@drawable/widget_button" />
    <TextView android:id="@+id/widget_home_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="5dp" android:gravity="center" android:textSize="11sp" android:padding="5dp" android:drawablePadding="4dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:background="@drawable/widget_button" />
    <TextView android:id="@+id/widget_meal_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="0dp" android:gravity="center" android:textSize="11sp" android:padding="5dp" android:drawablePadding="4dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:background="@drawable/widget_button" />
  </LinearLayout>
  <TextView android:id="@+id/widget_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="7dp" />
</LinearLayout>
